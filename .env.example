# =============================================================
# InvoiceGuard-AI 前台網站環境變數範本
# - 本機：複製為 .env 後填值（.env 不得提交版控）
# - Vercel：於 Project Settings → Environment Variables 設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production（非 local 時 cookie 只走 HTTPS）
APP_ENV=local
DEBUG=true

# ---- 後端 API（伺服器端呼叫，瀏覽器看不到）----
# InvoiceGuard-AI-API 位址（含版本路徑）
API_BASE_URL=http://localhost:8000/api/v1
API_TIMEOUT_SECONDS=30

# ---- 登入狀態 ----
# 登入 cookie 有效秒數（應與 API 的 JWT_EXPIRE_MINUTES 一致）
SESSION_MAX_AGE_SECONDS=3600
