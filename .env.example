# =============================================================
# InvoiceGuard-AI 前台網站環境變數範本
# - 僅供設定名稱參考；程式永遠不讀 dotenv，勿複製或下載公司密鑰
# - Vercel：於 Project Settings → Environment Variables 分 Preview／Production 設定
# - VERCEL／VERCEL_ENV 由平台注入；APP_ENV 必須對應 preview／production
# - 詳見 docs/ENVIRONMENT_ISOLATION.md；此檔不是可直接套用的雲端設定
# - 新增變數時，必須同步更新本檔與 app/core/config.py
# =============================================================

# ---- 基本 ----
# 執行環境：local / preview / production（非 local 時 cookie 只走 HTTPS）
APP_ENV=local
DEBUG=false

# ---- 後端 API（伺服器端呼叫，瀏覽器看不到）----
# InvoiceGuard-AI-API 位址（含版本路徑）
# 本機預設只由 local source 提供；雲端必填核定 HTTPS API 網址（含 /api/v1）
API_BASE_URL=
API_TIMEOUT_SECONDS=30

# ---- 登入狀態 ----
# 登入 cookie 有效秒數上限；實際取此值與 API 回傳的 Session 有效秒數（SESSION_EXPIRE_MINUTES）較小者
SESSION_MAX_AGE_SECONDS=3600
